# Copy this file's values into your PowerShell environment (do not commit real secrets).
# Default app uses local H2; set DB_* only when using the mysql profile.
DB_URL=jdbc:mysql://localhost:3306/smart_campus?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=NewPass@123

# SMTP example for Gmail: use an App Password, never your normal account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-sender@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SMTP_FROM=your-sender@gmail.com
# Resource / connection limits
SERVER_MAX_CONNECTIONS=200
SERVER_ACCEPT_COUNT=50
SERVER_MAX_THREADS=100
SERVER_MIN_THREADS=10
